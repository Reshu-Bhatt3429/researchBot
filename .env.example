# Polymarket CLOB API credentials
# Get these from: https://docs.polymarket.com
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here

# Polygon wallet private key (for live trading only)
POLYGON_PRIVATE_KEY=your_private_key_here

# Premium RPC endpoint (research: required for sub-100ms execution)
# Free tier works for paper trading, use Chainstack/Alchemy for live
POLYGON_RPC_URL=https://polygon-rpc.com

# Optional: PostgreSQL for production paper trading
# DATABASE_URL=postgresql://user:pass@localhost:5432/polymarket_bot
